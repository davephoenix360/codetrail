# Firebase Web App config (from Firebase Console → Project Settings → General → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_MEASUREMENT_ID=

# GitHub OAuth app (from https://github.com/settings/developers → your app)
# Required: client_id (the client_secret is stored in Firebase Functions secrets, NOT here)
EXPO_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
